{
  "name": "lebse-mobile",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "check": "tsc --noEmit",
    "export": "node scripts/export.mjs",
    "preview:android": "eas build --platform android --profile preview",
    "preview:ios": "eas build --platform ios --profile preview",
    "production:apk": "eas build --platform android --profile production-apk",
    "production:aab": "eas build --platform android --profile production",
    "production:submit": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "expo": "57.0.22",
    "expo-router": "~57.0.21",
    "expo-linking": "~57.0.10",
    "expo-constants": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-worklets": "0.10.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {"@types/react":"~19.2.2","typescript":"~5.9.2","@react-native/metro-config":"0.86.3"}
}
