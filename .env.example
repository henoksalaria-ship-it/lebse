# Local sandbox only. Set these in the server process environment; this file is not loaded automatically.
# Generate unique random values of at least 32 characters. Never prefix these with VITE_.
LEBSE_OPS_TOKEN=
LEBSE_TEST_WEBHOOK_SECRET=
LEBSE_DELIVERY_PROVIDER=mock
LEBSE_BACKUP_KEY=
# Backup key: 64 hexadecimal characters (32 random bytes), separate from the operator key.
# Keep an offline recovery copy. A lost key makes encrypted backups unrecoverable.
# Yango is intentionally disabled until its Ethiopia API access and contract are confirmed.
